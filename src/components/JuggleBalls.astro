---
/** Motivo gráfico decorativo: tres bolas de malabar sobre una trayectoria. */
interface Props {
  palette?: 'warm' | 'fresh' | 'light';
  class?: string;
}

const { palette = 'warm', class: className = '' } = Astro.props;

const COLORS = {
  warm: ['#F29B62', '#F8D85B', '#A33646'],
  fresh: ['#F8D85B', '#38735B', '#F29B62'],
  light: ['#F8D85B', '#FFF9F1', '#F29B62'],
} as const;

const [a, b, c] = COLORS[palette];
---

<svg class={`juggle ${className}`} viewBox="0 0 240 190" aria-hidden="true" focusable="false">
  <path
    class="juggle__path"
    d="M26 176 C 46 26, 194 26, 214 176"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-dasharray="1 9"
    stroke-linecap="round"></path>
  <circle class="juggle__ball" cx="54" cy="103" r="22" fill={a}></circle>
  <circle class="juggle__ball" cx="120" cy="63" r="17" fill={b}></circle>
  <ellipse class="juggle__ball" cx="128" cy="44" rx="7" ry="3.5" fill="#38735B" transform="rotate(-28 128 44)"></ellipse>
  <circle class="juggle__ball" cx="186" cy="103" r="27" fill={c}></circle>
  <circle class="juggle__shine" cx="178" cy="94" r="5" fill="#FFF9F1" opacity="0.45"></circle>
</svg>

<style>
  .juggle {
    overflow: visible;
  }

  .juggle__path {
    opacity: 0.55;
  }

  .juggle__ball,
  .juggle__shine {
    transform-box: fill-box;
    transform-origin: center;
    animation: ball-in 0.3s var(--ease) both;
  }

  .juggle__ball:nth-of-type(2) {
    animation-delay: 0.08s;
  }

  .juggle__ball:nth-of-type(3),
  .juggle__ball:nth-of-type(4) {
    animation-delay: 0.16s;
  }

  .juggle__shine {
    animation-delay: 0.24s;
  }

  @keyframes ball-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.85);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .juggle__ball,
    .juggle__shine {
      animation: none !important;
      transform: none !important;
      opacity: 1 !important;
    }
  }
</style>

---
import JuggleBalls from '../components/JuggleBalls.astro';
import PageIntro from '../components/PageIntro.astro';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FRUIT_GROUPS, FRUITS, type FruitGroup } from '../data/fruits';
import { PAGES } from '../data/site';
import { url } from '../lib/paths';

const page = PAGES.fruta;
const groups = Object.entries(FRUIT_GROUPS) as [FruitGroup, string][];
---

<BaseLayout {...page}>
  <PageIntro
    crumb="Fruta fresca"
    eyebrow="La gama · Fruta"
    title="Fruta fresca"
    lead="Las trece frutas que nombra la marca, reunidas en una cuadrícula para recorrerlas con calma.">
    <div slot="actions" class="btn-row">
      <a class="btn btn--primary" href="#recorrido">Ver las frutas <span class="arrow" aria-hidden="true">↓</span></a>
    </div>
    <div slot="visual" class="fruit-visual" aria-hidden="true">
      <span class="fruit-visual__disc"></span>
      <div class="fruit-visual__art">
        <Picture src="gama/fruta-divertida.png" alt="" width={368} height={558} priority />
      </div>
      <JuggleBalls class="fruit-visual__balls" />
    </div>
  </PageIntro>

  <section id="recorrido" class="section tone-paper range" aria-labelledby="range-title">
    <div class="container">
      <div class="range-head">
        <header class="section-head">
          <p class="eyebrow">La fruta de Malabar</p>
          <h2 id="range-title">Trece frutas, trece maneras de jugar</h2>
          <p>Las frutas que aparecen nombradas en la marca, ordenadas para recorrerlas con calma.</p>
        </header>

        <div class="filters js-only">
          <p class="filters__label" id="filters-label">Filtrar por tipo</p>
          <div class="filters__chips" role="group" aria-labelledby="filters-label" data-filter>
            <button class="chip" type="button" aria-pressed="true" data-filter-value="todas">Todas</button>
            {
              groups.map(([value, label]) => (
                <button class="chip" type="button" aria-pressed="false" data-filter-value={value}>
                  {label}
                </button>
              ))
            }
          </div>
          <p class="filters__status" aria-live="polite" data-filter-status>Mostrando las 13 frutas</p>
        </div>
      </div>

      <ul class="reset-list fruit-grid" data-filter-list>
        {
          FRUITS.map((fruit, index) => (
            <li class="fruit-card" data-group={fruit.group} style={`--fruit: ${fruit.color}; --accent: ${fruit.accent}`}>
              <div class="fruit-card__header">
                <span class="fruit-card__index" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="fruit-card__group">{FRUIT_GROUPS[fruit.group]}</span>
              </div>
              <span class="fruit-card__ball" aria-hidden="true">
                <span />
              </span>
              <div class="fruit-card__body">
                <h3>{fruit.name}</h3>
                <p class="fruit-card__line">{fruit.line}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="range-note">
        La agrupación por tipo y las descripciones son un recurso de esta propuesta para ordenar la cuadrícula: no proceden de la
        comunicación de la marca.
      </p>
    </div>
  </section>

  <section class="section fruit-cta" aria-labelledby="fruit-cta-title">
    <div class="container fruit-cta__inner">
      <h2 id="fruit-cta-title">¿Quieres saber más de la marca?</h2>
      <p class="lead">Escríbenos y lo vemos.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={url(PAGES.contacto.path)}>Contactar <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--outline" href={url(PAGES.verduras.path)}>Ver las verduras</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const group = document.querySelector<HTMLElement>('[data-filter]');
  const list = document.querySelector<HTMLElement>('[data-filter-list]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (group && list && status) {
    const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-filter-value]'));
    const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-group]'));

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.filterValue ?? 'todas';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

        let visible = 0;
        cards.forEach((card) => {
          const show = value === 'todas' || card.dataset.group === value;
          card.hidden = !show;
          if (show) visible += 1;
        });

        const label = button.textContent?.trim().toLowerCase() ?? '';
        status.textContent =
          value === 'todas' ? `Mostrando las ${visible} frutas` : `Mostrando ${visible} ${visible === 1 ? 'fruta' : 'frutas'}: ${label}`;
      });
    });
  }
</script>

<style>

  /* Visual de cabecera */
  .fruit-visual {
    position: relative;
    display: grid;
    place-items: center;
    max-width: 26rem;
    margin-inline: auto;
    padding-top: 2rem;
  }

  .fruit-visual__disc {
    position: absolute;
    inset: 18% 0 4%;
    border-radius: 50%;
    background: var(--apricot-400);
  }

  .fruit-visual__art {
    position: relative;
    width: min(70%, 17rem);
    rotate: 3deg;
    mix-blend-mode: multiply;
  }

  .fruit-visual :global(.fruit-visual__balls) {
    position: absolute;
    top: 0;
    left: -4%;
    width: 38%;
    color: var(--cocoa-600);
  }

  /* Filtros */
  .range-head {
    display: grid;
    gap: 2rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (min-width: 64rem) {
    .range-head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }
  }

  .range-head .section-head {
    margin-bottom: 0;
  }

  .filters {
    display: grid;
    gap: 0.75rem;
  }

  .filters__label {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .filters__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.15rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    background: var(--cream-50);
    font-size: 0.9688rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), border-color 0.2s var(--ease), color 0.2s var(--ease);
  }

  .chip:hover {
    border-color: var(--malabar-700);
  }

  .chip[aria-pressed='true'] {
    border-color: var(--malabar-700);
    background: var(--malabar-700);
    color: var(--cream-50);
  }

  .chip[aria-pressed='true']::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--lemon-300);
  }

  .filters__status {
    font-size: 0.875rem;
    color: var(--cocoa-600);
  }

  /* Tarjetas */
  .fruit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }

  .fruit-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 20rem;
    overflow: hidden;
    padding: 1.75rem;
    border-top: 4px solid var(--fruit);
    border-radius: var(--radius-card);
    background: var(--cream-50);
    box-shadow: 0 4px 12px -4px rgb(53 39 39 / 0.06);
    transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
    animation: fade-up 0.25s var(--ease) both;
  }

  .fruit-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px -8px rgb(53 39 39 / 0.12);
  }

  .fruit-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    position: relative;
    z-index: 2;
  }

  .fruit-card__index {
    font-size: 0.8125rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--cocoa-600);
    letter-spacing: 0.05em;
  }

  .fruit-card__group {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--paper-100);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--malabar-700);
  }

  .fruit-card__ball {
    position: absolute;
    top: 3.5rem;
    right: 1.25rem;
    width: 6.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--fruit);
    box-shadow: inset -10px -12px 0 rgb(53 39 39 / 0.12);
    transition: transform 0.35s var(--ease);
    opacity: 0.85;
    pointer-events: none;
  }

  .fruit-card__ball span {
    position: absolute;
    left: -12%;
    bottom: -2%;
    width: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--cream-50);
  }

  .fruit-card:hover .fruit-card__ball {
    transform: translateY(-6px) rotate(-6deg) scale(1.05);
    opacity: 1;
  }

  .fruit-card__body {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding-top: 3rem;
  }

  .fruit-card h3 {
    font-size: clamp(2.25rem, 1.8rem + 1.2vw, 2.85rem);
    line-height: 1.02;
    color: var(--cocoa-900);
  }

  .fruit-card__line {
    margin-top: 0.6rem;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--cocoa-600);
  }

  @media (min-width: 64rem) {
    .fruit-card:first-child {
      grid-column: span 2;
      background: var(--paper-100);
    }

    .fruit-card:first-child .fruit-card__ball {
      width: 9.5rem;
    }

    .fruit-card:first-child .fruit-card__ball span {
      border-color: var(--paper-100);
    }

    .fruit-card:first-child h3 {
      font-size: 3.25rem;
    }
  }

  .range-note {
    max-width: 46rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-size: 0.9375rem;
    color: var(--cocoa-600);
  }

  .fruit-cta__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .fruit-cta__inner .lead {
    margin-top: 1rem;
  }

  .fruit-cta__inner .btn-row {
    justify-content: center;
  }
</style>

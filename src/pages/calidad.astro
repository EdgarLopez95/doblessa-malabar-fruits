---
import JuggleBalls from '../components/JuggleBalls.astro';
import PageIntro from '../components/PageIntro.astro';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES } from '../data/site';
import { url } from '../lib/paths';

const page = PAGES.calidad;

// Valores presentes en la comunicación original de la marca. Se describen como
// tales, sin convertirlos en procesos internos ni en resultados comprobados.
const values = [
  { title: 'Selección', text: 'La marca habla de selección hortofrutícola.', color: 'var(--apricot-400)' },
  { title: 'Sabor', text: 'Un valor presente en la comunicación de la marca.', color: 'var(--malabar-600)' },
  { title: 'Aspecto', text: 'El aspecto del producto forma parte de ese mismo relato.', color: 'var(--lemon-300)' },
  { title: 'Frescura', text: 'La frescura aparece como valor declarado.', color: 'var(--leaf-600)' },
  { title: 'Higiene', text: 'La higiene se nombra junto a la calidad del producto.', color: 'var(--apricot-400)' },
  { title: 'Controles', text: 'La marca menciona controles de calidad, sin detallar procedimientos.', color: 'var(--malabar-600)' },
];
---

<BaseLayout {...page}>
  <PageIntro
    crumb="Calidad"
    eyebrow="Calidad"
    title="Calidad"
    lead="Selección, sabor, aspecto, frescura, higiene y controles: los valores que Malabar Fruits pone por delante cuando habla de su producto.">
    <div slot="visual" class="quality-visual">
      <div class="quality-visual__mark">
        <Picture src="calidad/compromiso-calidad-malabar.png" alt="" width={576} height={185} priority />
      </div>
      <JuggleBalls class="quality-visual__balls" palette="fresh" />
    </div>
  </PageIntro>

  <section class="section tone-paper" aria-labelledby="values-title">
    <div class="container values-grid">
      <div class="values-copy">
        <p class="eyebrow">Seis palabras</p>
        <h2 id="values-title">Lo que la marca pone por delante</h2>
        <p class="lead">
          Son los términos con los que Malabar Fruits habla de su fruta y su verdura. Aquí se recogen tal cual: como valores de marca, no como
          la descripción de un procedimiento interno.
        </p>
        <JuggleBalls class="values-balls" />
      </div>

      <ol class="reset-list values-list">
        {
          values.map((value, index) => (
            <li class="value-row" style={`--value: ${value.color}`}>
              <span class="value-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="value-dot" aria-hidden="true" />
              <div>
                <h3>{value.title}</h3>
                <p>{value.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section certs" aria-labelledby="certs-title">
    <div class="container certs-inner">
      <header class="certs-head">
        <p class="eyebrow">Sellos de la marca</p>
        <h2 id="certs-title">Certificaciones</h2>
        <p class="lead">Certificaciones presentes en la comunicación original de Malabar Fruits.</p>
      </header>

      <div class="certs-panel">
        <Picture
          src="calidad/logotipos-certificaciones-malabar.png"
          alt="Certificados mostrados en la web original de Malabar Fruits: GLOBALG.A.P., IFS Food y QS."
          width={800}
          height={176}
        />
      </div>
    </div>
  </section>

  <section class="section--tight quality-cta" aria-labelledby="quality-cta-title">
    <div class="container quality-cta__inner">
      <h2 id="quality-cta-title">¿Quieres saber más de la marca?</h2>
      <p class="lead">El canal de contacto definitivo está pendiente de validación.</p>
      <a class="btn btn--primary" href={url(PAGES.contacto.path)}>Contactar <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .quality-visual {
    position: relative;
    display: grid;
    place-items: center;
    gap: 2rem;
    width: min(100%, 24rem);
    margin-inline: auto;
    padding-block: 2rem;
  }

  .quality-visual::before {
    content: '';
    position: absolute;
    inset: 0 -8% 0 -8%;
    border-radius: 50%;
    background: var(--paper-100);
  }

  /* Rótulo heredado de la web original */
  .quality-visual__mark {
    position: relative;
    width: 78%;
    mix-blend-mode: multiply;
  }

  .quality-visual :global(.quality-visual__balls) {
    position: relative;
    width: 58%;
    color: var(--cocoa-600);
  }

  .values-grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  @media (min-width: 56rem) {
    .values-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }

    .values-copy {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .values-copy .lead {
    margin-top: 1.25rem;
  }

  .values-copy :global(.values-balls) {
    display: none;
  }

  @media (min-width: 56rem) {
    .values-copy :global(.values-balls) {
      display: block;
      width: 68%;
      margin-top: 3rem;
      color: var(--cocoa-600);
    }
  }

  .values-list {
    border-top: 1px solid var(--line-strong);
  }

  .value-row {
    display: grid;
    grid-template-columns: 3.25rem 1.25rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    align-items: baseline;
    padding-block: clamp(1.25rem, 1rem + 1.2vw, 2rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .value-num {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    line-height: 1;
    color: var(--cocoa-600);
  }

  .value-dot {
    width: 1.1rem;
    height: 1.1rem;
    align-self: center;
    border-radius: 50%;
    background: var(--value);
  }

  .value-row h3 {
    font-size: clamp(1.5rem, 1.25rem + 0.8vw, 1.875rem);
  }

  .value-row p {
    margin-top: 0.3rem;
    color: var(--cocoa-600);
  }

  /* Certificaciones */
  .certs-inner {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    justify-items: center;
    text-align: center;
  }

  .certs-head {
    display: grid;
    justify-items: center;
    max-width: 44rem;
  }

  .certs-head h2 {
    font-size: clamp(2.5rem, 1.8rem + 3vw, 3.75rem);
  }

  .certs-head .lead {
    margin-top: 1rem;
  }

  .certs-panel {
    display: grid;
    place-items: center;
    width: min(100%, 60rem);
    padding: clamp(2rem, 1.25rem + 4vw, 4rem) clamp(1.5rem, 1rem + 4vw, 4.5rem);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-panel);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .certs-panel :global(img) {
    width: min(100%, 44rem);
  }

  .quality-cta__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .quality-cta__inner .lead {
    margin-block: 1rem 2rem;
  }
</style>

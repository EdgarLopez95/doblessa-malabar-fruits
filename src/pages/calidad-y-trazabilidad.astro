---
import JuggleBalls from '../components/JuggleBalls.astro';
import PageIntro from '../components/PageIntro.astro';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES, PRO_CONTACT } from '../data/site';
import { url } from '../lib/paths';

const page = PAGES.calidad;

const pillars = [
  {
    title: 'Selección',
    text: 'Elegir el producto es el primer gesto de marca. La intención es sencilla: que lo que lleva el nombre Malabar tenga sabor, buen aspecto y ganas de comerse.',
    color: 'var(--apricot-400)',
  },
  {
    title: 'Frescura',
    text: 'Lo fresco se nota y se cuida. Queremos que la fruta y la verdura mantengan su mejor cara, respetando el ritmo natural de cada producto.',
    color: 'var(--leaf-600)',
  },
  {
    title: 'Cuidado de la presentación',
    text: 'Una pieza bien presentada se entiende rápido, en casa y en el lineal. Por eso la imagen de la marca acompaña al producto, nunca lo tapa.',
    color: 'var(--lemon-300)',
  },
  {
    title: 'Relación profesional',
    text: 'Con clientes y colaboradores, calidad también es claridad: hablar de gama, necesidades y expectativas antes de prometer nada.',
    color: 'var(--malabar-600)',
  },
];
---

<BaseLayout {...page}>
  <PageIntro
    crumb="Calidad y selección"
    eyebrow="Calidad"
    title="Selección y calidad de principio a fin"
    lead="La calidad no cabe en un sello decorativo. Para Malabar Fruits se construye con decisiones concretas: qué se elige, cómo se cuida y cómo se cuenta.">
    <div slot="visual" class="quality-visual" aria-hidden="true">
      <div class="quality-visual__seal">
        <Picture src="calidad/compromiso-calidad-malabar.png" alt="" width={576} height={185} priority />
      </div>
      <JuggleBalls class="quality-visual__balls" palette="fresh" />
    </div>
  </PageIntro>

  <section class="section tone-paper pillars" aria-labelledby="pillars-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Cuatro ideas de calidad</p>
        <h2 id="pillars-title">Lo que cuidamos, dicho con sencillez</h2>
        <p>Sin porcentajes ni promesas grandilocuentes: un recorrido editorial que explica el criterio de la marca paso a paso.</p>
      </header>

      <ol class="reset-list pillar-editorial">
        {
          pillars.map((pillar, index) => (
            <li class="pillar-row" style={`--pillar: ${pillar.color}`}>
              <div class="pillar-marker">
                <span class="pillar-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="pillar-dot" aria-hidden="true" />
              </div>
              <div class="pillar-content">
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section traceability" aria-labelledby="trace-title">
    <div class="container trace-grid">
      <div class="trace-copy">
        <p class="eyebrow">Trazabilidad y certificaciones</p>
        <h2 id="trace-title">Cuando el equipo aporte origen y controles, irán aquí</h2>
        <div class="prose trace-text">
          <p>
            Origen, procesos y controles sanitarios son información rigurosa. En esta web no los sustituimos con sellos decorativos, iconos genéricos ni certificaciones no validadas formalmente por el equipo de Limosin Fruits / Malabar Fruits.
          </p>
          <p>
            Hoy no se publican certificados, orígenes de fincas ni calendarios cerrados porque no están validados documentalmente. Cuando el equipo aporte datos verificados y documentación oficial, se publicarán de forma transparente en este espacio.
          </p>
          <p>
            Si tu empresa o central de compras necesita especificaciones concretas de producto o requisitos técnicos, lo tratamos directamente en conversación con el equipo comercial.
          </p>
        </div>
      </div>

      <div class="trace-compare">
        <div class="trace-box">
          <h3>Lo que encontrarás hoy</h3>
          <ul>
            <li>Criterios de selección y frescura de la marca.</li>
            <li>Tono y propuesta visual de Malabar Fruits.</li>
            <li>Vía directa de contacto con el equipo.</li>
          </ul>
        </div>
        <div class="trace-box trace-box--dark on-dark">
          <h3>Lo que hablamos en conversación</h3>
          <ul>
            <li>Consultas técnicas sobre partidas y orígenes.</li>
            <li>Requisitos y homologaciones de tu empresa.</li>
            <li>La gama concreta y formatos de cada momento.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight quality-cta" aria-labelledby="quality-cta-title">
    <div class="container">
      <div class="quality-cta__card tone-leaf on-dark">
        <h2 id="quality-cta-title">¿Quieres conocer los detalles?</h2>
        <p class="lead">Cuéntanos qué información necesitas y conversamos.</p>
        <div class="btn-row">
          <a class="btn btn--lemon" href={url(PRO_CONTACT)}>Hablar con el equipo <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--outline" href={url(PAGES.profesionales.path)}>Para profesionales</a>
          <a class="link-arrow" href={url(PAGES.contacto.path)}>Otras consultas</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quality-visual {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 24rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .quality-visual::before {
    content: '';
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: var(--paper-100);
  }

  .quality-visual::after {
    content: '';
    position: absolute;
    inset: 12%;
    border: 2px dashed var(--line-strong);
    border-radius: 50%;
  }

  .quality-visual__seal {
    position: relative;
    width: 72%;
    mix-blend-mode: multiply;
  }

  .quality-visual :global(.quality-visual__balls) {
    position: absolute;
    top: -6%;
    right: -4%;
    width: 42%;
    color: var(--cocoa-600);
  }

  /* Recorrido editorial de pilares */
  .pillar-editorial {
    display: grid;
    gap: 1.5rem;
  }

  .pillar-row {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
    border-radius: var(--radius-panel);
    border-left: 6px solid var(--pillar);
    background: var(--cream-50);
    box-shadow: 0 4px 16px -6px rgb(53 39 39 / 0.08);
    transition: transform 0.25s var(--ease);
  }

  .pillar-row:hover {
    transform: translateX(4px);
  }

  @media (min-width: 52rem) {
    .pillar-row {
      grid-template-columns: 6rem minmax(0, 1fr);
      align-items: start;
      gap: 2.5rem;
    }
  }

  .pillar-marker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pillar-num {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 2rem + 1vw, 3.25rem);
    line-height: 1;
    color: var(--pillar);
  }

  .pillar-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--pillar);
  }

  .pillar-content h3 {
    font-size: clamp(1.75rem, 1.4rem + 0.8vw, 2.25rem);
    color: var(--cocoa-900);
  }

  .pillar-content p {
    margin-top: 0.6rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--cocoa-600);
    max-width: 52rem;
  }

  /* Trazabilidad */
  .trace-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 56rem) {
    .trace-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
      align-items: center;
    }
  }

  .trace-text {
    max-width: 36rem;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--cocoa-600);
  }

  .trace-compare {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .trace-compare {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .trace-box {
    padding: 1.75rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-panel);
  }

  .trace-box--dark {
    border-color: var(--cocoa-900);
    background: var(--cocoa-900);
    color: var(--cream-50);
  }

  .trace-box h3 {
    font-size: 1.375rem;
  }

  .trace-box ul {
    display: grid;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .trace-box li {
    position: relative;
    padding-left: 1.4rem;
  }

  .trace-box li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--apricot-400);
  }

  .trace-box--dark li::before {
    background: var(--lemon-300);
  }

  .quality-cta__card {
    padding: clamp(2rem, 1.25rem + 4vw, 4.5rem);
    border-radius: var(--radius-panel);
  }

  .quality-cta__card .lead {
    margin-top: 0.75rem;
  }

  .quality-cta__card .btn-row {
    align-items: center;
  }
</style>

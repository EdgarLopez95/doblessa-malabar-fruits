---
import JuggleBalls from '../components/JuggleBalls.astro';
import PageIntro from '../components/PageIntro.astro';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES, PRO_CONTACT } from '../data/site';
import { url } from '../lib/paths';

const page = PAGES.calidad;

const pillars = [
  {
    title: 'Selección',
    text: 'Elegir el producto es el primer gesto de marca. La intención es sencilla: que lo que lleva el nombre Malabar tenga sabor, buen aspecto y ganas de comerse.',
    color: 'var(--apricot-400)',
  },
  {
    title: 'Frescura',
    text: 'Lo fresco se nota y se cuida. Queremos que la fruta y la verdura mantengan su mejor cara, respetando el ritmo natural de cada producto.',
    color: 'var(--leaf-600)',
  },
  {
    title: 'Cuidado de la presentación',
    text: 'Una pieza bien presentada se entiende rápido, en casa y en el lineal. Por eso la imagen de la marca acompaña al producto, nunca lo tapa.',
    color: 'var(--lemon-300)',
  },
  {
    title: 'Relación profesional',
    text: 'Con clientes y colaboradores, calidad también es claridad: hablar de gama, necesidades y expectativas antes de prometer nada.',
    color: 'var(--malabar-600)',
  },
];
---

<BaseLayout {...page}>
  <PageIntro
    crumb="Calidad y trazabilidad"
    eyebrow="Calidad"
    title="Calidad y trazabilidad"
    lead="La calidad no cabe en un sello decorativo. Para Malabar Fruits se construye con decisiones concretas: qué se elige, cómo se cuida y cómo se cuenta.">
    <div slot="visual" class="quality-visual" aria-hidden="true">
      <div class="quality-visual__seal">
        <Picture src="calidad/compromiso-calidad-malabar.png" alt="" width={576} height={185} priority />
      </div>
      <JuggleBalls class="quality-visual__balls" palette="fresh" />
    </div>
  </PageIntro>

  <section class="section tone-paper pillars" aria-labelledby="pillars-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Cuatro ideas de calidad</p>
        <h2 id="pillars-title">Lo que cuidamos, dicho con sencillez</h2>
        <p>Sin porcentajes ni promesas grandilocuentes: una forma de trabajar que se entiende de un vistazo.</p>
      </header>

      <ol class="reset-list pillar-path">
        {
          pillars.map((pillar, index) => (
            <li class="pillar" style={`--pillar: ${pillar.color}`}>
              <span class="pillar__marker" aria-hidden="true">
                {index + 1}
              </span>
              <div class="pillar__body">
                <h3>{pillar.title}</h3>
                <p>{pillar.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section traceability" aria-labelledby="trace-title">
    <div class="container trace-grid">
      <div class="trace-copy">
        <p class="eyebrow">Trazabilidad</p>
        <h2 id="trace-title">Datos antes que adjetivos</h2>
        <div class="prose trace-text">
          <p>
            Origen, procesos y documentación son información seria. En esta web no los resumimos con sellos, iconos ni cifras sueltas.
          </p>
          <p>
            Si tu empresa necesita conocer esos detalles, lo tratamos directamente con el equipo comercial, con la información que corresponda a
            cada caso.
          </p>
        </div>
      </div>

      <div class="trace-compare">
        <div class="trace-box">
          <h3>Lo que encontrarás aquí</h3>
          <ul>
            <li>Cómo entiende la marca la calidad.</li>
            <li>El tono y los valores de Malabar Fruits.</li>
            <li>Una vía clara para contactar.</li>
          </ul>
        </div>
        <div class="trace-box trace-box--dark on-dark">
          <h3>Lo que hablamos en conversación</h3>
          <ul>
            <li>Consultas sobre origen y procesos.</li>
            <li>Requisitos específicos de tu empresa.</li>
            <li>La gama concreta de cada momento.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight quality-cta" aria-labelledby="quality-cta-title">
    <div class="container">
      <div class="quality-cta__card tone-leaf on-dark">
        <h2 id="quality-cta-title">¿Quieres conocer los detalles?</h2>
        <p class="lead">Cuéntanos qué información necesitas y conversamos.</p>
        <div class="btn-row">
          <a class="btn btn--lemon" href={url(PRO_CONTACT)}>Hablar con el equipo <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--outline" href={url(PAGES.profesionales.path)}>Para profesionales</a>
          <a class="link-arrow" href={url(PAGES.contacto.path)}>Otras consultas</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quality-visual {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 24rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .quality-visual::before {
    content: '';
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background: var(--paper-100);
  }

  .quality-visual::after {
    content: '';
    position: absolute;
    inset: 12%;
    border: 2px dashed var(--line-strong);
    border-radius: 50%;
  }

  .quality-visual__seal {
    position: relative;
    width: 72%;
    mix-blend-mode: multiply;
  }

  .quality-visual :global(.quality-visual__balls) {
    position: absolute;
    top: -6%;
    right: -4%;
    width: 42%;
    color: var(--cocoa-600);
  }

  /* Recorrido de pilares */
  .pillar-path {
    position: relative;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 60rem) {
    .pillar-path {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .pillar-path::before {
      content: '';
      position: absolute;
      top: 2rem;
      left: 2rem;
      right: 2rem;
      border-top: 2px dashed var(--line-strong);
    }

    .pillar:nth-child(even) {
      margin-top: 3rem;
    }
  }

  .pillar {
    position: relative;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  @media (max-width: 59.99rem) {
    .pillar {
      grid-template-columns: 4rem minmax(0, 1fr);
    }
  }

  .pillar__marker {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background: var(--pillar);
    font-family: var(--font-display);
    font-size: 1.75rem;
    color: var(--cocoa-900);
    box-shadow: 0 0 0 6px var(--paper-100);
  }

  .pillar:nth-child(2) .pillar__marker,
  .pillar:nth-child(4) .pillar__marker {
    color: var(--cream-50);
  }

  .pillar__body {
    padding: 1.5rem;
    border-radius: var(--radius-card);
    background: var(--cream-50);
  }

  .pillar__body p {
    margin-top: 0.6rem;
    color: var(--cocoa-600);
  }

  /* Trazabilidad */
  .trace-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 56rem) {
    .trace-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
      align-items: center;
    }
  }

  .trace-text {
    max-width: 36rem;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--cocoa-600);
  }

  .trace-compare {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 40rem) {
    .trace-compare {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .trace-box {
    padding: 1.75rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-panel);
  }

  .trace-box--dark {
    border-color: var(--cocoa-900);
    background: var(--cocoa-900);
    color: var(--cream-50);
  }

  .trace-box h3 {
    font-size: 1.375rem;
  }

  .trace-box ul {
    display: grid;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .trace-box li {
    position: relative;
    padding-left: 1.4rem;
  }

  .trace-box li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--apricot-400);
  }

  .trace-box--dark li::before {
    background: var(--lemon-300);
  }

  .quality-cta__card {
    padding: clamp(2rem, 1.25rem + 4vw, 4.5rem);
    border-radius: var(--radius-panel);
  }

  .quality-cta__card .lead {
    margin-top: 0.75rem;
  }

  .quality-cta__card .btn-row {
    align-items: center;
  }
</style>

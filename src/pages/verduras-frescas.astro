---
import PageIntro from '../components/PageIntro.astro';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES } from '../data/site';
import { url } from '../lib/paths';

const page = PAGES.verduras;
---

<BaseLayout {...page}>
  <PageIntro
    crumb="Verduras frescas"
    eyebrow="La gama · Verdura"
    title="Verduras frescas"
    lead="Malabar Fruits es una marca de fruta y verdura fresca. Esta es la mitad verde de esa gama, contada con el mismo tono.">
    <div slot="visual" class="veg-visual" aria-hidden="true">
      <span class="veg-visual__orbit"></span>
      <span class="veg-visual__ball veg-visual__ball--green"></span>
      <span class="veg-visual__ball veg-visual__ball--red"></span>
      <span class="veg-visual__ball veg-visual__ball--yellow"></span>
      <span class="veg-visual__ball veg-visual__ball--purple"></span>
    </div>
    <div slot="after" class="veg-strip">
      <Picture src="inicio/hero-fruta-malabar.jpg" alt="Surtido de fruta y verdura fresca" width={1920} height={249} priority />
    </div>
  </PageIntro>

  <section class="section tone-paper statement" aria-labelledby="statement-title">
    <div class="container statement-grid">
      <h2 id="statement-title" class="statement-title">
        La verdura, con el mismo <em>espíritu</em> que la fruta.
      </h2>
      <div class="statement-copy">
        <p>
          Color, juego y producto cotidiano: lo que la marca propone con la fruta vale igual para la verdura. Es la otra mitad de la gama y
          comparte con ella el mismo cuidado y la misma forma de mirar.
        </p>
        <a class="link-arrow" href={url(PAGES.calidad.path)}>Los valores de la marca <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <div class="statement-field" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="pending-title">
    <div class="container">
      <div class="pending-card">
        <span class="pending-card__badge">Pendiente de validación</span>
        <div class="pending-card__body">
          <h2 id="pending-title">Qué verduras entran en la gama</h2>
          <p>
            La web de la marca nombra la verdura, pero no publica variedades. Aquí no se inventa ninguna: el detalle de la selección se añadirá
            cuando el cliente lo confirme.
          </p>
          <a class="link-arrow" href={url(PAGES.fruta.path)}>Mientras tanto, mira la fruta <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section veg-cta" aria-labelledby="veg-cta-title">
    <div class="container veg-cta__inner">
      <h2 id="veg-cta-title">¿Quieres saber más de la marca?</h2>
      <p class="lead">Escríbenos y lo vemos.</p>
      <a class="btn btn--primary" href={url(PAGES.contacto.path)}>Contactar <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .veg-visual {
    position: relative;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .veg-visual__orbit {
    position: absolute;
    inset: 6%;
    border: 2px dashed var(--line-strong);
    border-radius: 50%;
  }

  .veg-visual__ball {
    position: absolute;
    border-radius: 50%;
    box-shadow: inset -14px -16px 0 rgb(53 39 39 / 0.12);
    animation: fade-up 0.3s var(--ease) both;
  }

  .veg-visual__ball--green {
    top: 24%;
    left: 18%;
    width: 52%;
    aspect-ratio: 1;
    background: var(--leaf-600);
  }

  .veg-visual__ball--green::after {
    content: '';
    position: absolute;
    top: -12%;
    left: 44%;
    width: 26%;
    height: 13%;
    border-radius: 50%;
    background: #b9c35c;
    rotate: -30deg;
  }

  .veg-visual__ball--red {
    top: 2%;
    right: 6%;
    width: 26%;
    aspect-ratio: 1;
    background: var(--malabar-600);
    animation-delay: 0.08s;
  }

  .veg-visual__ball--yellow {
    right: 4%;
    bottom: 12%;
    width: 21%;
    aspect-ratio: 1;
    background: var(--lemon-300);
    animation-delay: 0.16s;
  }

  .veg-visual__ball--purple {
    bottom: 4%;
    left: 10%;
    width: 14%;
    aspect-ratio: 1;
    background: #5a3a55;
    animation-delay: 0.24s;
  }

  @media (max-width: 55.99rem) {
    .veg-visual {
      display: none;
    }
  }

  .veg-strip {
    margin-top: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    mix-blend-mode: multiply;
  }

  .veg-strip :global(img) {
    width: 100%;
    min-height: 8rem;
    object-fit: cover;
    object-position: 60% 50%;
  }

  /* Declaración editorial */
  .statement-grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 3.5rem);
  }

  @media (min-width: 56rem) {
    .statement-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      align-items: end;
    }

    .statement-title {
      grid-column: 1 / -1;
    }
  }

  .statement-title {
    max-width: 18ch;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4rem);
    line-height: 1.04;
  }

  .statement-title em {
    color: var(--leaf-600);
  }

  .statement-copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 34rem;
    font-size: 1.125rem;
    color: var(--cocoa-600);
  }

  /* Campo de color: recurso gráfico, sin significado de producto */
  .statement-field {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(0.4rem, 0.2rem + 0.6vw, 0.75rem);
  }

  .statement-field span {
    flex: 1 1 0;
    max-width: 3.75rem;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .statement-field span:nth-child(1) { background: var(--leaf-600); }
  .statement-field span:nth-child(2) { background: var(--lemon-300); transform: translateY(-0.75rem); }
  .statement-field span:nth-child(3) { background: var(--malabar-600); }
  .statement-field span:nth-child(4) { background: #b9c35c; transform: translateY(0.5rem); }
  .statement-field span:nth-child(5) { background: var(--apricot-400); }
  .statement-field span:nth-child(6) { background: #5a3a55; transform: translateY(-0.5rem); }

  /* Aviso pendiente */
  .pending-card {
    display: grid;
    gap: 1rem 2.5rem;
    align-items: start;
    padding: clamp(1.75rem, 1rem + 3vw, 3rem);
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-panel);
  }

  @media (min-width: 48rem) {
    .pending-card {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

  .pending-card__badge {
    justify-self: start;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--lemon-300);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .pending-card__body {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .pending-card h2 {
    font-size: 1.75rem;
  }

  .pending-card p {
    max-width: 44rem;
    color: var(--cocoa-600);
  }

  .veg-cta__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .veg-cta__inner .lead {
    margin-block: 1rem 2rem;
  }
</style>

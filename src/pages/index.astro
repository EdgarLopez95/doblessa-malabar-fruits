---
import JuggleBalls from '../components/JuggleBalls.astro';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LIMOSIN_NOTE, PAGES, SITE } from '../data/site';
import { absoluteUrl, asset, url } from '../lib/paths';

const page = PAGES.home;
const home = absoluteUrl('/');

// Solo datos conocidos: nombre, URL del mockup y logotipo. Sin teléfono,
// dirección, servicios, precios ni valoraciones.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      name: SITE.name,
      url: home,
      inLanguage: 'es',
    },
    {
      '@type': 'Brand',
      '@id': `${home}#brand`,
      name: SITE.name,
      url: home,
      logo: absoluteUrl('/images/marca/logo-malabar-fruits.png'),
      description: 'Marca de fruta y verdura fresca.',
    },
  ],
};

const principles = ['Producto antes que decoración', 'El juego como lenguaje', 'Color en la mesa de cada día'];

// Carteles y mensajes de la comunicación original de Malabar Fruits.
// Se recuperan tal cual, atribuidos a la marca; no se amplían ni se
// convierten en afirmaciones nuevas.
const plays = [
  { image: 'gama/fruta-energia-natural.png', title: 'Energía natural' },
  { image: 'gama/fruta-dieta-equilibrada.png', title: 'Dieta equilibrada' },
  { image: 'gama/fruta-energia-diaria.png', title: 'Vitaminas sin parar' },
];

const quality = [
  { title: 'Selección', text: 'La marca habla de selección hortofrutícola.' },
  { title: 'Sabor y aspecto', text: 'Dos valores presentes en su comunicación.' },
  { title: 'Frescura', text: 'Un valor declarado por la marca.' },
  { title: 'Higiene y controles', text: 'Parte de su forma de hablar del producto.' },
];
---

<BaseLayout {...page} jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preload" as="image" type="image/webp" href={asset('inicio/hero-campana-malabar-movil.webp')} media="(max-width: 44.99em)" fetchpriority="high" />
    <link rel="preload" as="image" type="image/webp" href={asset('inicio/hero-campana-malabar.webp')} media="(min-width: 45em)" fetchpriority="high" />
  </Fragment>

  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">Fruta y verdura <em>fresca</em> para disfrutar cada día</h1>
        <p class="lead">
          Comer bien también es jugar. Malabar Fruits pone color, ritmo y buen humor a la fruta y la verdura de todos los días.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={url(PAGES.fruta.path)}>Descubre la fruta <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--outline" href={url(PAGES.verduras.path)}>Ver las verduras</a>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-frame">
          <Picture
            src="inicio/hero-campana-malabar.jpg"
            alt="Dos personas se ríen en una cocina mientras una de ellas hace malabares con dos naranjas"
            width={1920}
            height={717}
            priority
            sources={[{ media: '(max-width: 44.99em)', src: 'inicio/hero-campana-malabar-movil.jpg', width: 1085, height: 1077 }]}
          />
        </div>
        <JuggleBalls class="hero-balls" />
        <p class="hero-sticker"><span>Hoy toca</span> color</p>
      </div>
    </div>

    <div class="hero-strip" aria-hidden="true">
      <Picture src="inicio/hero-fruta-malabar.jpg" alt="" width={1920} height={249} />
    </div>
  </section>

  <!-- 2. Introducción de marca -->
  <section class="section intro" aria-labelledby="intro-title">
    <div class="container intro-grid">
      <div class="intro-art" aria-hidden="true">
        <div class="intro-crop">
          <Picture src="inicio/detalle-campana-malabar.png" alt="" width={774} height={585} />
        </div>
      </div>
      <div class="intro-copy">
        <p class="eyebrow">Qué es Malabar Fruits</p>
        <h2 id="intro-title" class="intro-title">Todos hemos hecho un malabar. Con la fruta, es más divertido.</h2>
        <div class="prose intro-text">
          <p>
            Malabar Fruits es una marca de fruta y verdura fresca que se toma el producto en serio y el tono con humor: color, juego y
            ganas de compartir lo que hay en la mesa.
          </p>
          <p>Fruta y verdura como parte de una alimentación equilibrada, sin fórmulas ni sermones.</p>
        </div>
        <ul class="reset-list principles">
          {principles.map((item) => <li>{item}</li>)}
        </ul>
        <img
          class="intro-mark"
          src={asset('gama/fruta-saludablemente-divertida.png')}
          alt="Saludablemente divertidas"
          width="576"
          height="185"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- 3. La gama -->
  <section id="gama" class="section section--wide gama tone-paper" aria-labelledby="gama-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">La gama</p>
        <h2 id="gama-title">Elige por dónde empezar</h2>
        <p>Fruta y verdura fresca, contadas con calma.</p>
      </header>

      <div class="gama-grid">
        <article class="gama-panel gama-panel--fruit">
          <div class="gama-panel__body">
            <p class="gama-panel__kicker">Trece frutas nombradas por la marca</p>
            <h3 class="gama-panel__title">
              <a class="stretched-link" href={url(PAGES.fruta.path)}>Fruta fresca</a>
            </h3>
            <p class="gama-panel__text">Melocotón, nectarina, paraguayo, cereza, kiwi y unas cuantas más.</p>
            <span class="gama-panel__cta" aria-hidden="true">Explorar la fruta <span class="arrow">→</span></span>
          </div>
          <div class="gama-panel__art" aria-hidden="true">
            <span class="orb orb--a"></span><span class="orb orb--b"></span><span class="orb orb--c"></span><span class="orbit"></span>
          </div>
        </article>

        <article class="gama-panel gama-panel--veg on-dark">
          <div class="gama-panel__body">
            <p class="gama-panel__kicker">La otra mitad de la gama</p>
            <h3 class="gama-panel__title">
              <a class="stretched-link" href={url(PAGES.verduras.path)}>Verduras frescas</a>
            </h3>
            <p class="gama-panel__text">Malabar Fruits es también verdura fresca.</p>
            <span class="gama-panel__cta" aria-hidden="true">Explorar las verduras <span class="arrow">→</span></span>
          </div>
          <div class="gama-panel__art" aria-hidden="true">
            <span class="orb orb--a"></span><span class="orb orb--b"></span><span class="orb orb--c"></span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. El juego de lo fresco -->
  <section class="play tone-malabar on-dark" aria-labelledby="play-title">
    <div class="play-stars" style={`background-image: url('${asset('marca/franja-estrellas-malabar.jpg')}')`} aria-hidden="true"></div>
    <div class="container section">
      <header class="section-head play-head">
        <p class="eyebrow">Del archivo de Malabar</p>
        <h2 id="play-title">Los carteles originales</h2>
        <p>Mensajes que la marca ya usaba en su web, recuperados tal cual.</p>
      </header>
      <ul class="reset-list play-grid">
        {
          plays.map((item) => (
            <li class="play-card">
              <div class="play-art" aria-hidden="true">
                <Picture src={item.image} alt="" width={474} height={744} />
              </div>
              <h3>{item.title}</h3>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Calidad -->
  <section class="section quality" aria-labelledby="quality-title">
    <div class="container quality-grid">
      <div class="quality-copy">
        <p class="eyebrow">Calidad</p>
        <h2 id="quality-title">Sabor, aspecto y frescura</h2>
        <p class="lead">
          Son las palabras con las que Malabar Fruits habla de su producto. Aquí se recogen como valores de marca, sin adornos ni sellos
          que todavía no están confirmados.
        </p>
        <a class="link-arrow" href={url(PAGES.calidad.path)}>Ver los valores de la marca <span class="arrow" aria-hidden="true">→</span></a>
      </div>
      <ol class="reset-list quality-list">
        {
          quality.map((item, index) => (
            <li>
              <span class="quality-num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Limosin Fruits -->
  <section class="section--tight limosin" aria-labelledby="limosin-title">
    <div class="container limosin-band">
      <img class="limosin-logo" src={asset('marca/limosin-fruits.png')} alt="Limosin Fruits" width="458" height="144" loading="lazy" decoding="async" />
      <div>
        <h2 id="limosin-title">Malabar y Limosin Fruits</h2>
        <p>{LIMOSIN_NOTE}</p>
      </div>
    </div>
  </section>

  <!-- 7. Contacto -->
  <section class="section contact-cta" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div class="contact-copy">
        <img
          class="contact-ticket"
          src={asset('contacto/ilustracion-contacto-malabar.png')}
          alt=""
          width="309"
          height="144"
          loading="lazy"
          decoding="async"
        />
        <h2 id="contact-title">¿Hablamos?</h2>
        <p class="lead">Escríbenos si quieres saber más sobre Malabar Fruits.</p>
        <p class="contact-pending"><span class="contact-pending__badge">Propuesta</span> El canal de contacto definitivo está pendiente de validación.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={url(PAGES.contacto.path)}>Ir a contacto <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero ------------------------------------------------------------------ */
  .hero {
    position: relative;
    padding-top: clamp(1.75rem, 1rem + 3vw, 4rem);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    }
  }

  .hero h1 {
    max-width: 13ch;
    font-size: clamp(2.625rem, 1.7rem + 3.7vw, 4.25rem);
    line-height: 1.03;
  }

  .hero h1 em {
    color: var(--malabar-600);
  }

  .hero .lead {
    margin-top: 1.5rem;
  }

  .hero-media {
    position: relative;
    padding: 1.5rem 0 0 1.5rem;
  }

  .hero-frame {
    position: relative;
    aspect-ratio: 11 / 10;
    overflow: hidden;
    border-radius: var(--radius-panel) var(--radius-panel) var(--radius-panel) clamp(6rem, 3rem + 10vw, 13rem);
    background: #d9d7d2;
  }

  .hero-frame :global(picture) {
    height: 100%;
  }

  .hero-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% 30%;
  }

  @media (max-width: 44.99em) {
    .hero-frame {
      aspect-ratio: 1085 / 700;
      border-radius: var(--radius-panel) var(--radius-panel) var(--radius-panel) 5.5rem;
    }

    .hero-frame :global(img) {
      object-position: 50% 0;
    }
  }

  .hero-media :global(.hero-balls) {
    position: absolute;
    top: -0.75rem;
    left: -0.5rem;
    width: clamp(6.5rem, 4rem + 8vw, 10.5rem);
    color: var(--cocoa-600);
  }

  .hero-sticker {
    position: absolute;
    right: clamp(0.75rem, 2vw, 1.75rem);
    bottom: clamp(-1.5rem, -2vw, -0.75rem);
    display: grid;
    place-content: center;
    width: clamp(6rem, 5rem + 3vw, 8rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--lemon-300);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem);
    line-height: 1;
    text-align: center;
    rotate: -10deg;
    box-shadow: var(--shadow-soft);
  }

  .hero-sticker span {
    display: block;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin-bottom: 0.2rem;
  }

  .hero-strip {
    margin-top: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    mix-blend-mode: multiply;
  }

  .hero-strip :global(img) {
    width: 100%;
    min-height: 7.5rem;
    object-fit: cover;
  }

  /* Intro ----------------------------------------------------------------- */
  .intro-grid {
    display: grid;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .intro-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    }
  }

  .intro-art {
    position: relative;
    max-width: 22rem;
    margin-inline: auto;
    width: 100%;
  }

  .intro-art::before {
    content: '';
    position: absolute;
    inset: 8% 4% 0;
    border-radius: 50%;
    background: var(--paper-100);
  }

  /* Recorte del grabado para mostrar solo al malabarista, sin el texto incrustado */
  .intro-crop {
    position: relative;
    aspect-ratio: 350 / 347;
    overflow: hidden;
  }

  .intro-crop :global(img) {
    position: absolute;
    top: -68.6%;
    left: -65.7%;
    width: 221.1%;
    max-width: none;
    mix-blend-mode: multiply;
  }

  .intro-title {
    max-width: 20ch;
    font-size: clamp(2.125rem, 1.5rem + 2.4vw, 3.25rem);
  }

  .intro-title::first-line {
    color: var(--malabar-700);
  }

  .intro-text {
    max-width: 40rem;
    margin-top: 1.5rem;
    font-size: 1.125rem;
    color: var(--cocoa-600);
  }

  .principles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  /* Rótulo heredado de la web original */
  .intro-mark {
    width: clamp(11rem, 8rem + 10vw, 16rem);
    margin-top: 2.5rem;
    mix-blend-mode: multiply;
  }

  .principles li {
    padding: 0.5rem 1rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* Gama ------------------------------------------------------------------ */
  .gama-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 56rem) {
    .gama-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: start;
    }

    .gama-panel--veg {
      margin-top: 5rem;
    }
  }

  .gama-panel {
    --panel-pad: clamp(1.75rem, 1rem + 3vw, 3rem);
    position: relative;
    /* Dos filas: el adorno arriba y el texto abajo. Nunca pueden solaparse. */
    display: grid;
    grid-template-rows: minmax(6rem, 1fr) auto;
    min-height: clamp(24rem, 18rem + 16vw, 34rem);
    overflow: hidden;
    padding: var(--panel-pad);
    border-radius: var(--radius-panel);
    transition: transform 0.3s var(--ease);
  }

  .gama-panel:hover {
    transform: translateY(-4px);
  }

  .gama-panel--fruit {
    background: var(--apricot-400);
    color: var(--cocoa-900);
  }

  .gama-panel--veg {
    background: var(--leaf-600);
    color: var(--cream-50);
  }

  .gama-panel__body {
    position: relative;
    z-index: 1;
    grid-row: 2;
    align-self: end;
    max-width: 32rem;
    margin-top: 1.75rem;
  }

  .gama-panel__kicker {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .gama-panel__title {
    margin-top: 0.5rem;
    font-size: clamp(2.5rem, 1.8rem + 3vw, 4rem);
    line-height: 1;
  }

  .gama-panel__text {
    margin-top: 1rem;
    font-size: 1.0625rem;
  }

  .gama-panel__cta {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .gama-panel:hover .arrow {
    transform: translateX(4px);
  }

  .gama-panel:has(.stretched-link:focus-visible) .gama-panel__cta {
    text-decoration-thickness: 4px;
  }

  /* Fila propia del adorno, recortada a su caja */
  .gama-panel__art {
    position: relative;
    grid-row: 1;
    min-height: 9rem;
    margin: calc(-1 * var(--panel-pad)) calc(-1 * var(--panel-pad)) 0;
    overflow: hidden;
    pointer-events: none;
  }

  /* Se dimensionan por la ALTURA de la fila: así ninguna queda partida
     por el recorte. Las grandes salen por el borde a propósito. */
  .orb,
  .orbit {
    height: var(--orb-h);
    width: auto;
    aspect-ratio: 1;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    transition: transform 0.4s var(--ease);
  }

  .gama-panel--fruit .orb--a {
    --orb-h: 210%;
    top: -64%;
    right: -12%;
    background: var(--malabar-600);
  }

  .gama-panel--fruit .orb--b {
    --orb-h: 50%;
    top: 24%;
    right: 34%;
    background: var(--lemon-300);
  }

  .gama-panel--fruit .orb--c {
    --orb-h: 24%;
    top: 16%;
    right: 58%;
    background: var(--leaf-600);
  }

  .gama-panel--fruit .orbit {
    --orb-h: 260%;
    position: absolute;
    top: -92%;
    right: -20%;
    border: 2px dashed rgb(53 39 39 / 0.35);
    border-radius: 50%;
  }

  .gama-panel--veg .orb--a {
    --orb-h: 230%;
    top: -70%;
    right: -16%;
    background: #2c5c49;
  }

  .gama-panel--veg .orb--b {
    --orb-h: 58%;
    top: 20%;
    right: 18%;
    background: var(--lemon-300);
  }

  .gama-panel--veg .orb--c {
    --orb-h: 30%;
    top: 34%;
    right: 44%;
    background: var(--apricot-400);
  }

  .gama-panel:hover .orb--b {
    transform: translateY(-8px);
  }

  .gama-panel:hover .orb--c {
    transform: translateY(6px);
  }

  /* Juego ----------------------------------------------------------------- */
  .play-stars {
    height: clamp(1rem, 0.6rem + 1.4vw, 1.75rem);
    background-repeat: repeat-x;
    background-position: center;
    background-size: auto 100%;
  }

  .play-head {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }

  .play-grid {
    display: grid;
    gap: 3rem 2rem;
  }

  @media (min-width: 48rem) {
    .play-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .play-card {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  /* Recorte superior: muestra la ilustración y oculta el texto incrustado */
  .play-art {
    width: min(100%, 17rem);
    aspect-ratio: 474 / 568;
    overflow: hidden;
    margin-bottom: 1rem;
    rotate: -2deg;
    transition: rotate 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .play-card:nth-child(2) .play-art {
    rotate: 2deg;
    transform: translateY(1.5rem);
  }

  .play-card:nth-child(2) h3 {
    margin-top: 1.5rem;
  }

  .play-card:hover .play-art {
    rotate: 0deg;
  }

  .play-art :global(img) {
    width: 100%;
  }

  .play-card h3 {
    font-size: clamp(1.625rem, 1.3rem + 1vw, 2rem);
  }

  .play-card p {
    max-width: 22rem;
    color: rgb(255 249 241 / 0.84);
  }

  @media (max-width: 47.99rem) {
    .play-card {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      justify-items: start;
      align-items: center;
      column-gap: 1.25rem;
      text-align: left;
    }

    .play-art {
      grid-row: span 2;
      margin: 0;
    }

    .play-card:nth-child(2) .play-art {
      transform: none;
    }

    .play-card:nth-child(2) h3 {
      margin-top: 0;
    }

    .play-card h3 {
      align-self: end;
    }

    .play-card p {
      align-self: start;
    }
  }

  /* Calidad --------------------------------------------------------------- */
  .quality-grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }

  @media (min-width: 56rem) {
    .quality-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: start;
    }

    .quality-copy {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    .quality-copy {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .quality-copy .lead {
    margin-block: 1.25rem 2rem;
  }

  .quality-list {
    border-top: 1px solid var(--line-strong);
  }

  .quality-list li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: clamp(1.4rem, 1rem + 1.5vw, 2.25rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .quality-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    line-height: 1;
    color: var(--malabar-700);
  }

  .quality-list h3 {
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
  }

  .quality-list p {

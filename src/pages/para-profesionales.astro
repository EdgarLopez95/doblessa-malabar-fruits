---
import ContactForm from '../components/ContactForm.astro';
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGES } from '../data/site';
import { url } from '../lib/paths';

const page = PAGES.profesionales;

const sectors = [
  { title: 'Retail', text: 'Una marca reconocible y con color para acompañar la sección de fresco y hacerla más apetecible.' },
  { title: 'Restauración', text: 'Fruta y verdura con buena presencia para cartas, desayunos, postres y propuestas de temporada.' },
  { title: 'Distribución', text: 'Una conversación directa sobre la gama y sobre cómo puede encajar en tu catálogo.' },
  { title: 'Colaboraciones de marca', text: 'Campañas, activaciones o proyectos que quieran sumar el tono lúdico y fresco de Malabar.' },
];

const expectations = [
  { title: 'Atención comercial', text: 'Tu consulta llega al equipo comercial, que la revisa para orientarte.' },
  { title: 'Conversación sobre la gama', text: 'Hablamos de la selección y de lo que realmente necesitas, sin catálogos cerrados.' },
  { title: 'Propuestas con atractivo', text: 'Nos interesa construir propuestas de producto que se vean bien y apetezcan.' },
];

const steps = [
  { title: 'Nos cuentas', text: 'Quién eres, qué tipo de negocio tienes y qué te gustaría explorar.' },
  { title: 'Lo revisamos', text: 'El equipo estudia tu consulta para entender el encaje.' },
  { title: 'Conversamos', text: 'Retomamos el contacto para concretar los siguientes pasos.' },
];
---

<BaseLayout {...page}>
  <PageIntro
    crumb="Para profesionales"
    eyebrow="Para profesionales"
    title="Fruta y verdura fresca para profesionales"
    lead="Malabar Fruits es una marca de fruta y verdura fresca con personalidad propia. Si trabajas en comercio, restauración o distribución, o quieres explorar una colaboración, hablemos de cómo puede encajar en tu propuesta.">
    <div slot="actions" class="btn-row">
      <a class="btn btn--primary" href="#formulario">Solicitar información <span class="arrow" aria-hidden="true">↓</span></a>
      <a class="btn btn--outline" href={url(PAGES.calidad.path)}>Cómo entendemos la calidad</a>
    </div>
    <nav slot="visual" class="pro-index" aria-label="En esta página">
      <p class="pro-index__title">En esta página</p>
      <ol class="reset-list">
        <li><a href="#sectores"><span>01</span> Con quién trabajamos</a></li>
        <li><a href="#que-esperar"><span>02</span> Qué puedes esperar</a></li>
        <li><a href="#como-empezamos"><span>03</span> Cómo empezamos</a></li>
        <li><a href="#formulario"><span>04</span> Solicitar información</a></li>
      </ol>
    </nav>
  </PageIntro>

  <section id="sectores" class="section tone-paper" aria-labelledby="sectors-title">
    <div class="container sectors-layout">
      <div class="sectors-proposal">
        <p class="eyebrow">Con quién trabajamos</p>
        <h2 id="sectors-title">Una marca pensada para distintas necesidades</h2>
        <div class="prose">
          <p class="lead">
            Malabar Fruits aporta valor en aquellos puntos donde la fruta y la verdura fresca deben destacar por presencia, color y cuidado visual.
          </p>
          <p>
            No trabajamos con fórmulas rígidas ni catálogos estandarizados. Analizamos tu modelo de negocio —sea un comercio de proximidad, una cocina profesional o una red de distribución— para construir una conversación directa, realista y ajustada a tu propuesta.
          </p>
        </div>
      </div>
      <ul class="reset-list sectors-list">
        {
          sectors.map((sector, index) => (
            <li class="sector-item">
              <div class="sector-item__meta">
                <span class="sector-item__num" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3>{sector.title}</h3>
              </div>
              <p class="sector-item__text">{sector.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="que-esperar" class="section" aria-labelledby="expect-title">
    <div class="container expect-grid">
      <header>
        <p class="eyebrow">Qué puedes esperar</p>
        <h2 id="expect-title">Claridad desde la primera conversación</h2>
        <p class="lead expect-lead">
          Preferimos no prometer condiciones en una web. Lo que sí podemos ofrecer es una forma de trabajar directa y con criterio.
        </p>
      </header>
      <ul class="reset-list expect-list">
        {
          expectations.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="como-empezamos" class="section tone-cocoa on-dark" aria-labelledby="steps-title">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Cómo empezamos</p>
        <h2 id="steps-title">Tres pasos, sin complicaciones</h2>
      </header>
      <ol class="reset-list steps">
        {
          steps.map((step, index) => (
            <li class="step">
              <span class="step__num" aria-hidden="true">
                {index + 1}
              </span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="formulario" class="section form-section" aria-labelledby="form-title">
    <div class="container form-grid-layout">
      <div class="form-aside">
        <p class="eyebrow">Solicitar información</p>
        <h2 id="form-title">Solicita información comercial</h2>
        <p class="lead">Déjanos tus datos y un breve contexto. Solo pedimos lo necesario para poder responderte.</p>
        <div class="form-aside__note">
          <h3>Sobre tus datos</h3>
          <p>
            En la versión final, la información se usaría únicamente para atender tu consulta, según la <a
              href={url(PAGES.privacidad.path)}>política de privacidad</a>.
          </p>
        </div>
      </div>
      <div class="form-card">
        <ContactForm variant="profesional" id="form-profesionales" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pro-index {
    padding: 1.75rem;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-panel);
    background: var(--cream-50);
  }

  .pro-index__title {
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--leaf-600);
  }

  .pro-index li + li {
    border-top: 1px solid var(--line);
  }

  .pro-index a {
    display: flex;
    gap: 1rem;
    padding: 0.85rem 0;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s var(--ease), padding 0.2s var(--ease);
  }

  .pro-index a:hover {
    color: var(--malabar-700);
    padding-left: 0.25rem;
  }

  .pro-index span {
    color: var(--cocoa-600);
    font-variant-numeric: tabular-nums;
  }

  /* Sectores - propuesta y lista con filetes */
  .sectors-layout {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 56rem) {
    .sectors-layout {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
      align-items: start;
    }

    .sectors-proposal {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .sectors-proposal .lead {
    margin-top: 1.25rem;
    color: var(--cocoa-900);
  }

  .sectors-proposal p:not(.lead) {
    color: var(--cocoa-600);
    font-size: 1.0625rem;
  }

  .sectors-list {
    display: grid;
    border-top: 1.5px solid var(--line-strong);
  }

  .sector-item {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.75rem;
    border-bottom: 1.5px solid var(--line-strong);
  }

  .sector-item__meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .sector-item__num {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--leaf-600);
    font-variant-numeric: tabular-nums;
  }

  .sector-item h3 {
    font-size: clamp(1.35rem, 1.2rem + 0.5vw, 1.75rem);
    color: var(--cocoa-900);
  }

  .sector-item__text {
    padding-left: 2.25rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--cocoa-600);
  }

  /* Expectativas */
  .expect-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 56rem) {
    .expect-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: 5rem;
    }
  }

  .expect-lead {
    margin-top: 1.25rem;
  }

  .expect-list li {
    display: grid;
    gap: 0.4rem;
    padding: 1.75rem 0 1.75rem 2.5rem;
    border-bottom: 1px solid var(--line-strong);
    position: relative;
  }

  .expect-list li:first-child {
    border-top: 1px solid var(--line-strong);
  }

  .expect-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 2.15rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--leaf-600);
  }

  .expect-list p {
    color: var(--cocoa-600);
  }

  /* Pasos */
  .steps {
    display: grid;
    gap: 2rem;
    counter-reset: step;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .step {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-light);
  }

  .step__num {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    background: var(--leaf-600);
    color: var(--cream-50);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .step p {
    color: rgb(255 249 241 / 0.84);
  }

  /* Formulario */
  .form-grid-layout {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 60rem) {
    .form-grid-layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 4rem;
      align-items: start;
    }

    .form-aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .form-aside .lead {
    margin-top: 1rem;
  }

  .form-aside__note {
    margin-top: 2rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--paper-100);
    font-size: 0.9375rem;
  }

  .form-aside__note h3 {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .form-aside__note p {
    margin-top: 0.35rem;
    color: var(--cocoa-600);
  }

  .form-aside__note a {
    color: var(--malabar-700);
    font-weight: 700;
  }

  .form-card {
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    background: var(--paper-100);
  }
</style>

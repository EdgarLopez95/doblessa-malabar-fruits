---
import PageIntro from '../components/PageIntro.astro';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { GENERAL_CONTACT, PAGES, PRO_CONTACT } from '../data/site';
import { url } from '../lib/paths';

const page = PAGES.limosin;
---

<BaseLayout {...page}>
  <PageIntro
    crumb="Malabar Fruits y Limosin Fruits"
    eyebrow="Marca y empresa"
    title="Malabar Fruits y Limosin Fruits"
    lead="Dos nombres que comparten sector: el de la fruta y la verdura fresca. Así se relacionan, contado con la información disponible.">
    <div slot="visual" class="duo" aria-hidden="true">
      <div class="duo__logo duo__logo--malabar">
        <Picture src="marca/logo-malabar-fruits.png" alt="" width={300} height={108} priority />
      </div>
      <span class="duo__and">y</span>
      <div class="duo__logo duo__logo--limosin">
        <Picture src="marca/limosin-fruits.png" alt="" width={458} height={144} priority />
      </div>
    </div>
  </PageIntro>

  <section class="section tone-paper" aria-labelledby="relation-title">
    <div class="container relation-grid">
      <div class="relation-copy">
        <p class="eyebrow">La relación</p>
        <h2 id="relation-title">Una marca dentro de un universo más amplio</h2>
        <div class="prose relation-text">
          <p>
            Según la información disponible, Malabar Fruits es una marca de fruta y verdura fresca vinculada a Limosin Fruits, empresa del sector
            hortofrutícola que figura como titular de la marca.
          </p>
          <p>
            Malabar aporta el tono: color, cercanía y una forma lúdica de acercarse a lo fresco. Limosin Fruits aporta el marco empresarial en el
            que la marca se desarrolla.
          </p>
        </div>
      </div>

      <ul class="reset-list relation-cards">
        <li class="relation-card">
          <p class="relation-card__role">La marca</p>
          <h3>Malabar Fruits</h3>
          <p>Da nombre y personalidad a la fruta y la verdura fresca, con un lenguaje pensado para disfrutar y compartir.</p>
        </li>
        <li class="relation-card relation-card--dark on-dark">
          <p class="relation-card__role">La empresa vinculada</p>
          <h3>Limosin Fruits</h3>
          <p>Empresa del sector de la fruta y la verdura fresca a la que está vinculada la marca Malabar.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section--tight" aria-labelledby="pending-title">
    <div class="container">
      <div class="pending">
        <span class="pending__badge">Pendiente de validación</span>
        <div>
          <h2 id="pending-title">Datos corporativos</h2>
          <p>
            La historia, la actividad y los datos de contacto de Limosin Fruits se incorporarán a esta página cuando estén confirmados. Hasta
            entonces, preferimos no adelantar información.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section limosin-cta" aria-labelledby="limosin-cta-title">
    <div class="container limosin-cta__inner">
      <h2 id="limosin-cta-title">¿Quieres saber más de la marca?</h2>
      <p class="lead">Escríbenos y te orientamos, tanto si eres profesional como si simplemente sientes curiosidad.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={url(GENERAL_CONTACT)}>Contactar <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--outline" href={url(PRO_CONTACT)}>Soy profesional</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .duo {
    display: grid;
    justify-items: center;
    gap: 1rem;
    max-width: 24rem;
    margin-inline: auto;
  }

  .duo__logo {
    display: grid;
    place-items: center;
    width: 100%;
    padding: 2rem 2.5rem;
    border-radius: var(--radius-panel);
  }

  .duo__logo--malabar {
    background: var(--paper-100);
    rotate: -2deg;
  }

  .duo__logo--limosin {
    border: 1.5px solid var(--line-strong);
    background: #fff;
    rotate: 1.5deg;
  }

  .duo__logo :global(img) {
    width: min(100%, 13rem);
  }

  .duo__and {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-block: -1.75rem;
    z-index: 1;
    border-radius: 50%;
    background: var(--lemon-300);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-style: italic;
  }

  .relation-grid {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 56rem) {
    .relation-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 5rem;
      align-items: center;
    }
  }

  .relation-text {
    max-width: 38rem;
    margin-top: 1.25rem;
    font-size: 1.125rem;
    color: var(--cocoa-600);
  }

  .relation-cards {
    display: grid;
    gap: 1rem;
  }

  .relation-card {
    padding: 2rem;
    border-radius: var(--radius-panel);
    background: var(--cream-50);
  }

  .relation-card--dark {
    background: var(--cocoa-900);
    color: var(--cream-50);
  }

  .relation-card__role {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--malabar-600);
  }

  .relation-card--dark .relation-card__role {
    color: var(--lemon-300);
  }

  .relation-card h3 {
    margin-top: 0.25rem;
    font-size: 2rem;
  }

  .relation-card p:last-child {
    margin-top: 0.6rem;
    color: var(--cocoa-600);
  }

  .relation-card--dark p:last-child {
    color: rgb(255 249 241 / 0.84);
  }

  .pending {
    display: grid;
    gap: 1rem 2.5rem;
    align-items: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1.5px dashed var(--line-strong);
    border-radius: var(--radius-panel);
  }

  @media (min-width: 48rem) {
    .pending {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }

  .pending__badge {
    justify-self: start;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--lemon-300);
    font-size: 0.8125rem;
    font-weight: 800;
  }

  .pending h2 {
    font-size: 1.75rem;
  }

  .pending p {
    max-width: 44rem;
    margin-top: 0.5rem;
    color: var(--cocoa-600);
  }

  .limosin-cta__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .limosin-cta__inner .lead {
    margin-top: 1rem;
  }

  .limosin-cta__inner .btn-row {
    justify-content: center;
  }
</style>

---
import ContactForm from '../components/ContactForm.astro';
import PageIntro from '../components/PageIntro.astro';
import Picture from '../components/Picture.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LIMOSIN_NOTE, PAGES } from '../data/site';

const page = PAGES.contacto;
---

<BaseLayout {...page}>
  <PageIntro
    crumb="Contacto"
    eyebrow="Hablemos"
    title="Contacto Malabar Fruits"
    lead="Escríbenos para saber más de la marca: la gama, el color y todo lo que hay detrás.">
    <div slot="visual" class="contact-visual" aria-hidden="true">
      <span class="contact-visual__disc"></span>
      <div class="contact-visual__ticket">
        <Picture src="contacto/ilustracion-contacto-malabar.png" alt="" width={309} height={144} priority />
      </div>
      <span class="contact-visual__ball contact-visual__ball--a"></span>
      <span class="contact-visual__ball contact-visual__ball--b"></span>
    </div>
  </PageIntro>

  <section class="section tone-paper" aria-labelledby="contact-form-title">
    <div class="container contact-layout">
      <div class="contact-main">
        <h2 id="contact-form-title" class="visually-hidden">Formulario de contacto</h2>
        <div class="contact-panel">
          <ContactForm id="form-contacto" />
        </div>
      </div>

      <aside class="contact-aside" aria-labelledby="aside-title">
        <h2 id="aside-title">Hablemos de fruta</h2>
        <p>
          Cuéntanos qué te gustaría saber: la gama, la marca o cualquier otra cosa que te ronde. Malabar Fruits es fruta y verdura fresca, y
          de eso podemos hablar largo.
        </p>
        <p class="contact-aside__note">{LIMOSIN_NOTE}</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-visual {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 22rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  .contact-visual__disc {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: var(--paper-100);
  }

  .contact-visual__ticket {
    position: relative;
    width: 86%;
    rotate: -6deg;
    filter: drop-shadow(0 18px 24px rgb(53 39 39 / 0.18));
  }

  .contact-visual__ball {
    position: absolute;
    border-radius: 50%;
  }

  .contact-visual__ball--a {
    top: 6%;
    right: 10%;
    width: 18%;
    aspect-ratio: 1;
    background: var(--apricot-400);
  }

  .contact-visual__ball--b {
    bottom: 12%;
    left: 8%;
    width: 11%;
    aspect-ratio: 1;
    background: var(--leaf-600);
  }

  .contact-layout {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 60rem) {
    .contact-layout {
      grid-template-columns: minmax(0, 8fr) minmax(0, 3.5fr);
      gap: 3.5rem;
      align-items: start;
    }

    .contact-aside {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .contact-main {
    display: grid;
    gap: 2rem;
  }

  .contact-panel {
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border-radius: var(--radius-panel);
    background: var(--cream-50);
  }

  .contact-aside {
    display: grid;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: var(--radius-panel);
    background: var(--cocoa-900);
    color: var(--cream-50);
  }

  .contact-aside h2 {
    font-size: 1.75rem;
  }

  .contact-aside p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgb(255 249 241 / 0.86);
  }

  .contact-aside__note {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-light);
    color: rgb(255 249 241 / 0.72) !important;
  }
</style>
